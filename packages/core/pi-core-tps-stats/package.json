{
	"name": "@arhen/pi-core-tps-stats",
	"version": "1.3.4",
	"type": "module",
	"description": "Minimalist pi extension: live tokens-per-second stats for the active model",
	"license": "MIT",
	"main": "./src/index.ts",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "node --experimental-strip-types src/index.test.ts",
		"check": "npm run typecheck && npm run lint && npm test"
	},
	"files": [
		"src",
		"!src/*.test.ts",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/arhen/pi-extensions",
		"directory": "packages/core/pi-core-tps-stats"
	},
	"author": "arhen"
}
