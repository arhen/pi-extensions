{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"formatter": { "enabled": true, "lineWidth": 120 },
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	}
}
