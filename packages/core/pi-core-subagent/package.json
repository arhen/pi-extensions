{
	"name": "@arhen/pi-core-subagent",
	"version": "1.3.65",
	"type": "module",
	"description": "pi extension: fast in-process subagents with a dependency-graph scheduler (needs edges gate tasks and carry upstream output into dependent prompts), plus background runs, intercom and agent-to-agent mailbox. Leader defines agents inline.",
	"license": "MIT",
	"main": "./src/index.ts",
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "bun run typecheck && bun run lint && bun test"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"subagent",
		"agent-orchestration",
		"task-graph",
		"dag",
		"graph-protocol"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/arhen/pi-extensions",
		"directory": "packages/core/pi-core-subagent"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
