{
	"name": "@arhen/pi-core-ask",
	"version": "1.0.12",
	"type": "module",
	"description": "Minimalist pi questionnaire: ask_user_question tool with up to 4 structured questions (2-4 options, multiSelect, previews, type-something).",
	"license": "MIT",
	"main": "./src/index.ts",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test test",
		"check": "npm run typecheck && npm run lint && npm test"
	},
	"files": [
		"src",
		"assets",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"questionnaire",
		"ask"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arhen/pi-extensions.git",
		"directory": "packages/core/pi-core-ask"
	}
}
