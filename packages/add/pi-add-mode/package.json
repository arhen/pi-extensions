{
	"name": "@arhen/pi-add-mode",
	"version": "1.0.7",
	"description": "pi extension: named modes bundling instructions, tool set, model, subagent model and colour — create/enable/disable with /mode, switch with ctrl+tab.",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"mode",
		"preset",
		"workflow"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test",
		"check": "bun run typecheck && bun run lint && bun test"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@earendil-works/pi-ai": "^1.0.1",
		"@earendil-works/pi-coding-agent": "^1.0.1",
		"@earendil-works/pi-tui": "^1.0.1",
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/arhen/pi-extensions",
		"directory": "packages/add/pi-add-mode"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
