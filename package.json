{
	"name": "pi-extensions",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for @arhen pi extension packages (core + add) and the pi-toolset installer.",
	"type": "module",
	"workspaces": [
		"packages/core/*",
		"packages/add/*",
		"packages/pi-toolset"
	],
	"scripts": {
		"install:core": "bash packages/pi-toolset/pi-toolset install",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"lint": "npm run lint --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"check": "npm run typecheck && npm run lint && npm run test",
		"verify": "npm install --no-audit --no-fund && npm run check",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@earendil-works/pi-agent-core": "^1.0.1",
		"@earendil-works/pi-ai": "^1.0.1",
		"@earendil-works/pi-coding-agent": "^1.0.1",
		"@earendil-works/pi-tui": "^1.0.1",
		"typebox": "^1.3.27",
		"typescript": "^7.0.2"
	}
}