{
	"name": "pi-extensions",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for @arhen pi extension packages (core + add) and the pi-toolset installer.",
	"type": "module",
	"workspaces": [
		"packages/core/*",
		"packages/add/*",
		"packages/pi-toolset"
	],
	"scripts": {
		"install:core": "node packages/pi-toolset/pi-toolset install",
		"check": "npm run typecheck --workspaces --if-present",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"typescript": "^7.0.2"
	}
}